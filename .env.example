# Rallys Equities website — environment variables.
# Copy to .env.local for local development; set the same names in Vercel → Project → Settings → Environment Variables.

# Supabase project (public values: Row-Level Security protects the data).
# Optional — default to the production project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required server-only Supabase key for the form API. Apply editor/security-hardening.sql
# to revoke anonymous writes so /api/submissions is the only way in.
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Shared rate limits across server instances (recommended for production).
# Without these, limits apply to a single instance. If configured but unavailable,
# submissions fail closed with a recoverable 503 response.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Analytics 4 measurement id (e.g. G-XXXXXXXXXX). Empty = analytics off.
NEXT_PUBLIC_GA_ID=

# Sentry DSN for browser error monitoring. Empty = off.
NEXT_PUBLIC_SENTRY_DSN=
