# Rallys Equities website — environment variables.
# Copy to .env.local for local development; set the same names in Vercel → Project → Settings → Environment Variables.

# Supabase project (public values: Row-Level Security protects the data).
# Optional — default to the production project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase key for the form API. Recommended: with it set, anonymous inserts
# into form_submissions / form-uploads can be revoked so /api/submissions is the only way in.
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Google Analytics 4 measurement id (e.g. G-XXXXXXXXXX). Empty = analytics off.
NEXT_PUBLIC_GA_ID=

# Sentry DSN for browser error monitoring. Empty = off.
NEXT_PUBLIC_SENTRY_DSN=
