{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo \"static site — no install\"",
  "buildCommand": "echo \"static site — no build\"",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/services", "destination": "/index.html" },
    { "source": "/markets", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/open-account", "destination": "/index.html" },
    { "source": "/mission", "destination": "/index.html" },
    { "source": "/management", "destination": "/index.html" },
    { "source": "/rating", "destination": "/index.html" },
    { "source": "/governance", "destination": "/index.html" },
    { "source": "/services/trading", "destination": "/index.html" },
    { "source": "/services/corporate-accounts", "destination": "/index.html" },
    { "source": "/services/portfolio-management", "destination": "/index.html" },
    { "source": "/services/market-research", "destination": "/index.html" },
    { "source": "/services/shariah-investing", "destination": "/index.html" },
    { "source": "/services/trading-platforms", "destination": "/index.html" },
    { "source": "/services/support", "destination": "/index.html" },
    { "source": "/investors/portal", "destination": "/index.html" },
    { "source": "/investors/education", "destination": "/index.html" },
    { "source": "/investors/financial-highlights", "destination": "/index.html" },
    { "source": "/investors/awareness", "destination": "/index.html" },
    { "source": "/investors/policies", "destination": "/index.html" },
    { "source": "/tools/cagr-calculator", "destination": "/index.html" },
    { "source": "/tools/sip-calculator", "destination": "/index.html" },
    { "source": "/tools/investment-calculator", "destination": "/index.html" },
    { "source": "/tools/depreciation-calculator", "destination": "/index.html" },
    { "source": "/tools/ex-rate-calculator", "destination": "/index.html" },
    { "source": "/tools/dcf-calculator", "destination": "/index.html" },
    { "source": "/tools/fcf-calculator", "destination": "/index.html" },
    { "source": "/tools/drawdown-calculator", "destination": "/index.html" },
    { "source": "/faq", "destination": "/index.html" },
    { "source": "/downloads", "destination": "/index.html" },
    { "source": "/useful-links", "destination": "/index.html" },
    { "source": "/complaints", "destination": "/index.html" },
    { "source": "/careers", "destination": "/index.html" },
    { "source": "/feedback", "destination": "/index.html" },
    { "source": "/blog", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co; frame-src 'self' https://maps.google.com https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" }
      ]
    }
  ]
}
